+          # which also means `steps.published` could not run its own helper and
+          # this step's `if:` should not have matched. Belt and braces: drop the
+          # note rather than the invalidation, because the note is a courtesy
+          # and the invalidation is what stops a merge.
+          echo "::warning::the review invalidation helper was not staged from the default branch; removing the stale verdict labels without posting the note"
+          rc=0
+          gh pr edit "$PR" --repo "$REPO" --remove-label ai-review:pass || rc=1
+          gh pr edit "$PR" --repo "$REPO" --remove-label ai-review:blocking || rc=1
+          exit $rc
 
       - name: Converge the published reviewer verdict
