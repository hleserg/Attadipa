# ESP-IDF
build/
build-*/
# `build.flash/` — `idf.py -B build.flash` is a real thing people type, and
# `build-*` does not match it. 2218 generated files reached a pull request
# through that gap once; the dot is why.
build.*/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Rendered UI frames — `watch-ui-testing` writes them per run and they are
# evidence for one review, not a durable artefact.
tools/ui/out/

# CMake / native
cmake-build-*/
CMakeUserPresets.json
compile_commands.json
.cache/

# Secrets and keys — never commit these
secure_boot_signing_key*.pem
*_private.pem
*.key
credentials.*
secrets.*

# Measurement output (regenerate, don't version)
measurements/*.raw
*.log
# ...except a bench capture committed as the evidence for a MEASURED result.
!docs/research/*/*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Python bytecode from tools/
__pycache__/
*.py[cod]

# Archives dropped into the working directory to be unpacked.
# The unpacked result belongs in the tree; the archive does not, and one
# already reached a branch through a `git add -A` that meant well.
*.zip
*.tar.gz
*.tgz

# Pages fetched from vendor and distributor sites while researching a part.
# Same failure as the archives above and it happened a second time: a scraped
# Adafruit page reached `main` in #98 through `git add -A` from the repository
# root. What belongs in the tree is the *reading* of a source in
# docs/research/, identified by URL and revision — never the source itself,
# which is somebody else's copyrighted page. Only the two site files at
# docs/404.html and docs/index.html are tracked HTML; anything at the root is
# a stray.
/*.html
/*.htm
/*.pdf

# Private notes — not for publication
EASTER_EGGS.md

# Screenshots and scenario logs from tools/watch_control.py. Evidence for a
# review, not source: they are regenerated by running the tool and would
# otherwise put a megabyte of PNG into every UI commit.
artifacts/

# CTest's own scratch directory, written into the source tree whenever ctest is
# run from the repository root rather than from a build directory.
# CTestCostData.txt was committed once, by this route; ctest rewrites it, so
# every working tree that ever ran a test showed dirty.
Testing/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
