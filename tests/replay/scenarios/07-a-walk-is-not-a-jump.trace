  alt 42600
  acc 4100
  sats 11 14
  hdop 95
  speed 1400
  jam none
  spoof none
  motion moving
  expect trust trusted
  expect no-reason position-jump
  expect no-reason implausible-altitude-rate
  expect validity valid

