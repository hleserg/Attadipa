# T-Watch S3 Plus overlay. Stack it on sdkconfig.defaults:
#
#   idf.py -B build-twatch -DSDKCONFIG=build-twatch/sdkconfig \
#       -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.twatch" build
#
# -B and -DSDKCONFIG together for the reason sdkconfig.hil gives: idf.py keeps
# sdkconfig in the project directory, and a second build silently reuses it.

CONFIG_ATTADIPA_BOARD_TWATCH_S3_PLUS=y

# Flash: Winbond W25Q128JW (JEDEC 0xEF 0x4018), 16 MB. The factory image's
# header byte says DIO at 80 MHz — esptool image-info on the 2026-08-27 backup,
# MEASURED (docs/research/TWATCH_S3_PLUS_BRINGUP_2026-08-27.md:91 — "flash DIO
# @ 80 MHz, image says 16 MB"). That byte does not say what the part takes: the
# ROM reads the header as `dio` for every quad choice (sdkconfig.defaults:26 —
# "the *image header* mode as `dio` for every quad choice, because the ROM
# reads"), so a QIO build would carry it too. DIO is chosen because QIO is unproven on
# this part, not because the vendor is known to have chosen it. Size, PSRAM
# (8 MB octal) and console are the Waveshare's and stay.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
